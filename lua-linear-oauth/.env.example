# Copy to .env for local runs (lua test, lua chat -e sandbox), or set each with
#   lua env sandbox -k <KEY> -v <value>
# Production reads only what you set with `lua env production`.

# From your Linear OAuth application (Settings > API > OAuth applications)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Must match a callback URL registered on the application, character for character
LINEAR_REDIRECT_URI=https://heylua.ai/oauth/code?provider=linear
